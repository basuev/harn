diff --git a/providers/openai/provider.c b/providers/openai/provider.c
new file mode 100644
index 0000000..65f6f61
--- /dev/null
+++ b/providers/openai/provider.c
@@ -0,0 +1,38 @@
+#include "harn.h"
+#include "provider.h"
+#include <string.h>
+
+#ifndef OPENAI_PROMPT_CACHE_TTL
+#define OPENAI_PROMPT_CACHE_TTL "30m"
+#endif
+#ifndef OPENAI_STATIC_CACHE_TTL
+#define OPENAI_STATIC_CACHE_TTL "30m"
+#endif
+
+static json_t *openai_catalog(json_t *body)
+{
+    json_t *models = catalog_data(body), *model;
+    size_t i;
+    json_array_foreach(models, i, model) {
+        /* Confirmed API capabilities, not guesses based on a model-name prefix.
+         * Other catalog entries retain their server-reported metadata. */
+        if (!strcmp(jstr(model, "slug"), "gpt-6.1-sol")) {
+            json_object_set_new(model, "context_window", json_integer(1050000));
+            json_object_set_new(model, "supported_reasoning_levels",
+                                json_pack("[s,s,s,s,s]", "low", "medium", "high", "xhigh", "max"));
+            json_object_set_new(model, "default_reasoning_level", json_string("medium"));
+            json_object_set_new(model, "supports_reasoning_effort_updates", json_true());
+            json_object_set_new(model, "prompt_cache", json_pack("{s:s,s:s,s:b}",
+                "ttl", OPENAI_PROMPT_CACHE_TTL, "static_ttl", OPENAI_STATIC_CACHE_TTL,
+                "diagnostics", 1));
+        }
+    }
+    return models;
+}
+const Provider openai_provider = {
+    .id = "openai", .revision = "1", .auth_label = "API key",
+    .request_path = "/responses", .ready = api_key_ready, .logout = api_key_logout,
+    .models = responses_models, .catalog = openai_catalog, .headers = bearer_headers,
+    .encode = responses_cached_encode, .event = responses_event,
+    .legacy = api_key_legacy,
+};
