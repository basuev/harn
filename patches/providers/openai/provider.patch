+++ b/providers/openai/check.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""OpenAI API contract and modern cache controls, without real API credentials."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
+import check
+from provider_contract import Contract, run
+
+
+class OpenAICacheTests(unittest.TestCase):
+    setUp = Contract.setUp
+    tearDown = Contract.tearDown
+    run_batch = check.Checks.run_batch
+    session = check.Checks.session
+    records = check.Checks.records
+
+    def test_sol_api_enables_cache_options_and_effort_updates(self):
+        self.server.model_id = "gpt-6.1-sol"
+        self.server.mode = "echo"
+        self.run_batch("FIRST", "-m", "gpt-6.1-sol", "--effort", "low")
+        first = self.server.requests[-1]
+        self.assertEqual(first["prompt_cache_options"], dict(mode="implicit", ttl="30m"))
+        self.assertNotIn("instructions", first)
+        self.run_batch("SECOND", "--resume", "--effort", "high")
+        second = self.server.requests[-1]
+        self.assertEqual(second["reasoning"], dict(effort="low"))
+        self.assertTrue(any(i.get("type") == "configuration_update" and
+                            i["reasoning"]["effort"] == "high" for i in second["input"]))
+        self.assertEqual(check.Checks.saved_requests(self), self.server.requests)
+
+
+if __name__ == "__main__":
+    run("openai", key_env="OPENAI_API_KEY", extra=(OpenAICacheTests,))
