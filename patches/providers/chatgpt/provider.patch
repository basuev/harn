+
+/* @rfc{7518,4.7} The KEK oct length a GCM-KW alg requires. */
+static size_t gcmkw_kek_len(jwe_key_alg_t alg)
+{
+	switch (alg) {
+	case JWE_ALG_A128GCMKW:
+		return 16;
+	case JWE_ALG_A192GCMKW:
+		return 24;
+	case JWE_ALG_A256GCMKW:
