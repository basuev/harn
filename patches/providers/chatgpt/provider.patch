+	if (aad_len &&
+	    EVP_EncryptUpdate(ctx, NULL, &len, aad, (int)aad_len) != 1)
+		goto out; // LCOV_EXCL_LINE
+
+	if (EVP_EncryptUpdate(ctx, out, &len, pt, (int)pt_len) != 1)
+		goto out; // LCOV_EXCL_LINE
