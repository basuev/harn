+const char *jwt_alg_str(jwt_alg_t alg)
+{
+	switch (alg) {
+	case JWT_ALG_NONE:
+		return "none";
+	case JWT_ALG_HS256:
+		return "HS256";
+	case JWT_ALG_HS384:
+		return "HS384";
+	case JWT_ALG_HS512:
+		return "HS512";
+	case JWT_ALG_RS256:
+		return "RS256";
+	case JWT_ALG_RS384:
+		return "RS384";
+	case JWT_ALG_RS512:
+		return "RS512";
+	case JWT_ALG_ES256:
+		return "ES256";
+	case JWT_ALG_ES256K:
+		return "ES256K";
+	case JWT_ALG_ES384:
+		return "ES384";
+	case JWT_ALG_ES512:
+		return "ES512";
+	case JWT_ALG_PS256:
+		return "PS256";
+	case JWT_ALG_PS384:
+		return "PS384";
+	case JWT_ALG_PS512:
+		return "PS512";
+	case JWT_ALG_EDDSA:
+		return "EdDSA";
+#ifdef LIBJWT_HAVE_ML_DSA
+	case JWT_ALG_ML_DSA_44:
