+	jwt_json_obj_foreach(__cmd->c.headers, FUNC(seen_key_cb), &ctx);
+	if (!ctx.dup && __cmd->c.unprotected != NULL)
+		jwt_json_obj_foreach(__cmd->c.unprotected, FUNC(seen_key_cb),
+				     &ctx);
