+int jwks_error_any(const jwk_set_t *jwk_set)
+{
+	jwk_item_t *item = NULL;
+	int count;
+
+	if (jwk_set == NULL)
+		return 1;
+
+	count = jwk_set->error;
+
+	list_for_each_entry(item, &jwk_set->head, node) {
+		if (item->error)
+			count++;
+	}
+
+	return count;
+}
