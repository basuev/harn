+jwk_set_t *jwks_load(jwk_set_t *jwk_set, const char *jwk_json_str)
+{
+	size_t len;
+
+	if (jwk_json_str == NULL)
+		return NULL;
+
+	len = strlen(jwk_json_str);
+
+	return __jwks_load_strn(jwk_set, jwk_json_str, len, 0);
+}
