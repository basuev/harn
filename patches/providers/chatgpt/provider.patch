+{
+	switch (alg) {
+	case JWE_ALG_A128GCMKW:
+		return JWE_ENC_A128GCM;
+	case JWE_ALG_A192GCMKW:
+		return JWE_ENC_A192GCM;
+	case JWE_ALG_A256GCMKW:
+		return JWE_ENC_A256GCM;
+	// LCOV_EXCL_START
