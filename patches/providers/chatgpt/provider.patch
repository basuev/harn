+ * non-zero (with the error set) otherwise. */
+static int FUNC(check_disjoint)(jwe_common_t *__cmd)
+{
+	jwt_json_auto_t *seen = NULL;
+	struct jwe_seen_ctx ctx;
+	struct jwe_recipient *r;
