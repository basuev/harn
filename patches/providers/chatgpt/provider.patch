index 0000000..531f22b
--- /dev/null
+++ b/providers/chatgpt/check.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""Subscription authentication and adapter contract, using a local OIDC server."""
+import base64
+import json
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+import urllib.error
+import urllib.parse
+import urllib.request
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
+import check
+from provider_contract import Contract, run
+
+
+def b64(value):
+    return base64.urlsafe_b64encode(value).rstrip(b"=").decode()
+
+
+class OAuthHandler(check.Handler):
+    def do_GET(self):
+        base = "http://127.0.0.1:" + str(self.server.server_port)
+        if self.path == "/.well-known/openid-configuration":
+            self.server.discovery_calls += 1
+            self.fixed(dict(issuer=base, token_endpoint=base + "/token",
+                            authorization_endpoint=base + "/authorize", jwks_uri=base + "/jwks",
+                            revocation_endpoint=base + "/revoke"))
+        elif self.path == "/jwks":
+            self.fixed(dict(keys=[self.server.jwk]))
+        elif self.path.startswith("/authorize?"):
+            fields = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
+            self.server.login_fields = fields
+            query = dict(state=fields["state"][0], client_id="fixture", code="fixture-code")
+            if self.server.auth_mode == "decline":
+                query = dict(state=fields["state"][0], error="access_denied")
+            self.send_response(303)
+            self.send_header("Location", fields["redirect_uri"][0] + "?" + urllib.parse.urlencode(query))
+            self.end_headers()
+        else:
+            super().do_GET()
+
+    def do_POST(self):
+        if self.path == "/v1/responses" and getattr(self.server, "sharing_error", None):
+            raw = self.rfile.read(int(self.headers["Content-Length"]))
+            self.server.requests.append(json.loads(raw))
+            self.server.auth_headers.append(self.headers.get("Authorization"))
+            self.fixed(dict(error=dict(code=self.server.sharing_error, message="Subscription error")),
+                       self.server.sharing_status)
+            return
+        if self.path not in ("/token", "/revoke"):
+            return super().do_POST()
+        fields = urllib.parse.parse_qs(self.rfile.read(int(self.headers["Content-Length"])).decode())
+        if self.path == "/revoke":
+            self.server.revocations += 1
+            self.fixed({})
+            return
+        self.server.token_calls += 1
+        time.sleep(.15)
+        if self.server.mode == "refresh-failure":
+            self.fixed(dict(error="temporarily_unavailable"), 503)
+            return
+        tokens = dict(access_token="rotated-private", refresh_token="rotated-refresh",
+                      expires_in=3600, scope="chatgpt.tokens.use.direct")
+        if fields["grant_type"] == ["authorization_code"]:
+            self.server.exchange_fields = fields
+            nonce = self.server.login_fields["nonce"][0]
+            if self.server.auth_mode == "bad-nonce":
+                nonce = "wrong-nonce"
+            tokens["id_token"] = self.server.token(nonce)
+        self.fixed(tokens)
+
+
+class OAuthFixture(check.Fixture):
+    def __init__(self):
+        super().__init__(OAuthHandler)
+        self.auth_mode = "success"
+        self.revocations = 0
+        self.login_fields = self.exchange_fields = None
+        self.keys = tempfile.TemporaryDirectory(prefix="harn-oidc-")
+        self.private = Path(self.keys.name) / "key.pem"
+        subprocess.run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048",
+                        "-out", str(self.private)], check=True, capture_output=True)
+        modulus = subprocess.run(["openssl", "rsa", "-in", str(self.private), "-noout", "-modulus"],
+                                 check=True, capture_output=True).stdout.decode().strip().split("=", 1)[1]
+        self.jwk = dict(kty="RSA", kid="fixture", alg="RS256", use="sig",
+                        n=b64(bytes.fromhex(modulus)), e="AQAB")
+
+    def token(self, nonce):
+        claims = dict(iss="http://127.0.0.1:" + str(self.server_port), aud="fixture",
+                      exp=int(time.time()) + 3600, sub="fixture-subject", nonce=nonce)
+        message = b64(json.dumps(dict(alg="RS256", kid="fixture")).encode()) + "." + b64(json.dumps(claims).encode())
+        signature = subprocess.run(["openssl", "dgst", "-sha256", "-sign", str(self.private)],
+                                   input=message.encode(), check=True, capture_output=True).stdout
+        return message + "." + b64(signature)
+
+    def server_close(self):
+        super().server_close()
+        self.keys.cleanup()
+
+
+def configure(case):
+    case.env["HARN_AUTH_ISSUER"] = "http://127.0.0.1:" + str(case.server.server_port)
+    (case.config / "registration.json").write_text(json.dumps(dict(client_id="fixture", ext_agent_host_id="fixture")))
+    (case.config / "credentials.json").write_text(json.dumps(dict(
+        access_token="ACCESS_NEVER_SAVED", refresh_token="REFRESH_NEVER_SAVED",
+        scope="chatgpt.tokens.use.direct", saved_at=int(time.time()), expires_in=3600)))
+
+
+class SubscriptionTests(unittest.TestCase):
+    setUp = Contract.setUp
+    tearDown = Contract.tearDown
+    run_batch = check.Checks.run_batch
+
+    def start_login(self):
+        (self.config / "credentials.json").unlink(missing_ok=True)
+        p = subprocess.Popen([str(check.BINARY), "--login"], env=self.env,
+                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        end = time.monotonic() + 5
+        while time.monotonic() < end:
+            link = self.config / "login-url"
+            if link.exists():
+                return p, link.read_text()
+            time.sleep(.02)
+        p.terminate()
+        out, err = p.communicate(timeout=5)
+        self.fail((out, err))
+
+    def test_login_identity_pkce_and_logout(self):
+        p, url = self.start_login()
+        try:
+            with urllib.request.urlopen(url, timeout=5) as response:
+                self.assertEqual(response.status, 200)
+            out, err = p.communicate(timeout=10)
+            self.assertEqual(p.returncode, 0, (out, err))
+        finally:
+            if p.poll() is None:
+                p.terminate()
+                p.communicate(timeout=5)
+        credentials = self.config / "credentials.json"
+        self.assertEqual(credentials.stat().st_mode & 0o777, 0o600)
+        self.assertEqual(json.loads(credentials.read_text())["subject"], "fixture-subject")
+        import hashlib
+        verifier = self.server.exchange_fields["code_verifier"][0]
+        self.assertEqual(self.server.login_fields["code_challenge"], [b64(hashlib.sha256(verifier.encode()).digest())])
+        result = subprocess.run([str(check.BINARY), "--logout"], env=self.env, capture_output=True, timeout=5)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.server.revocations, 1)
+        self.assertFalse(credentials.exists())
+
+    def test_invalid_identity_and_declined_login_do_not_save_tokens(self):
+        for mode in ("bad-nonce", "decline"):
+            with self.subTest(mode=mode):
+                (self.config / "login-url").unlink(missing_ok=True)
+                self.server.auth_mode = mode
+                p, url = self.start_login()
+                try:
+                    with urllib.request.urlopen(url, timeout=5):
+                        pass
+                    out, err = p.communicate(timeout=10)
+                    self.assertEqual(p.returncode, 1, (out, err))
+                    self.assertFalse((self.config / "credentials.json").exists())
+                finally:
+                    if p.poll() is None:
+                        p.terminate()
+                        p.communicate(timeout=5)
+
+    def test_subscription_error_classification_precedes_refresh(self):
+        self.server.sharing_error = "subscription_sharing_user_not_eligible"
+        self.server.sharing_status = 401
+        self.run_batch("INELIGIBLE", expected=1)
+        self.assertEqual(len(self.server.requests), 1)
+        self.assertEqual(self.server.token_calls, 0)
+        self.server.requests.clear()
+        self.server.sharing_error = "subscription_sharing_usage_unavailable"
+        self.server.sharing_status = 400
+        self.run_batch("TEMPORARY", expected=1)
+        self.assertEqual(len(self.server.requests), 3)
+        self.assertEqual(self.server.token_calls, 0)
+
+    def test_pending_login_can_be_cancelled(self):
+        p, _ = self.start_login()
+        p.send_signal(signal.SIGINT)
+        out, err = p.communicate(timeout=5)
+        self.assertEqual(p.returncode, 1, (out, err))
+        self.assertFalse((self.config / "credentials.json").exists())
+
+    def test_refresh_failure_and_concurrent_rotation(self):
+        path = self.config / "credentials.json"
+        original = path.read_bytes()
+        self.server.mode = "refresh-failure"
+        result = subprocess.run([str(check.BINARY), "--login"], env=self.env, capture_output=True, timeout=5)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(path.read_bytes(), original)
+        expired = json.loads(original)
+        expired["saved_at"] = 0
+        path.write_text(json.dumps(expired))
+        self.server.mode = "echo"
+        self.server.token_calls = 0
+        processes = [subprocess.Popen([str(check.BINARY), "-C", str(self.project), "-p", "REFRESH"],
+                                     env=self.env, stdout=subprocess.PIPE, stderr=subprocess.PIPE) for _ in range(2)]
+        for p in processes:
+            out, err = p.communicate(timeout=10)
+            self.assertEqual(p.returncode, 0, (out, err))
+        self.assertEqual(self.server.token_calls, 1)
+        self.assertEqual(json.loads(path.read_text())["access_token"], "rotated-private")
+        self.assertEqual(path.stat().st_mode & 0o777, 0o600)
+
+
+if __name__ == "__main__":
+    run("chatgpt", configure=configure, fixture_class=OAuthFixture,
+        extra=(SubscriptionTests,), catalog_format="models")
