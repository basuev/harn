+	jwt_scrub_and_free(p, p ? (size_t)p_l : 0);
+	jwt_scrub_and_free(q, q ? (size_t)q_l : 0);
+	jwt_scrub_and_free(dp, dp ? (size_t)dp_l : 0);
+	jwt_scrub_and_free(dq, dq ? (size_t)dq_l : 0);
