+		return NULL;
+
+	if (token == NULL || !strlen(token)) {
+		jwt_write_error(__cmd, "Must pass a token");
+		return NULL;
+	}
+
+	recip = jwe_recipient_first(&__cmd->c);
+	if (recip == NULL || recip->key == NULL ||
+	    recip->key_alg == JWE_ALG_NONE) {
+		jwt_write_error(__cmd, "No key/algorithm set");
+		return NULL;
+	}
