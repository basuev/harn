+						 : GNUTLS_ECC_CURVE_X448)
+		       : (!strcmp(crv, "P-256") ? GNUTLS_ECC_CURVE_SECP256R1 :
+			  !strcmp(crv, "P-384") ? GNUTLS_ECC_CURVE_SECP384R1 :
+			  !strcmp(crv, "P-521") ? GNUTLS_ECC_CURVE_SECP521R1 :
+						  GNUTLS_ECC_CURVE_INVALID);
