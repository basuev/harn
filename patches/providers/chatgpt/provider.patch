+/* Is this ECDH-ES in Direct Key Agreement mode (the agreed key IS the CEK,
+ * no wrapping, empty Encrypted Key)? */
+int jwe_alg_is_ecdh_direct(jwe_key_alg_t alg)
+{
+	return alg == JWE_ALG_ECDH_ES;
+}
