+/* @rfc{7518,4.7} Is this an AES-GCM key-wrap algorithm? */
+int jwe_alg_is_gcmkw(jwe_key_alg_t alg)
+{
+	return alg == JWE_ALG_A128GCMKW || alg == JWE_ALG_A192GCMKW ||
+	       alg == JWE_ALG_A256GCMKW;
