+	if (len == 0)
+		return 1; // LCOV_EXCL_LINE
+
+	if (jwt_ops->rng == NULL)
+		return 1; // LCOV_EXCL_LINE
+
+	buf = jwt_malloc(len);
+	if (buf == NULL)
+		return 1; // LCOV_EXCL_LINE
+
+	if (jwt_ops->rng(buf, len)) {
+		// LCOV_EXCL_START
+		jwt_scrub_and_free(buf, len);
+		return 1;
+		// LCOV_EXCL_STOP
+	}
