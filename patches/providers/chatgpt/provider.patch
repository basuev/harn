+	    jtag == NULL || !jwt_json_is_string(jtag))
+		return 1;
+
+	iv = jwt_base64uri_decode(jwt_json_str_val(jiv), &iv_len);
+	tag = jwt_base64uri_decode(jwt_json_str_val(jtag), &tag_len);
+	if (iv == NULL || tag == NULL || iv_len <= 0 || tag_len <= 0)
+		goto out;
+
