+jwk_set_t *jwks_load_fromfp(jwk_set_t *jwk_set, FILE *input)
+{
+	jwt_json_auto_t *j_all = NULL;
+	jwt_json_error_t error;
+
+	if (input == NULL)
+		return NULL;
+
+	if (jwk_set == NULL)
+		jwk_set = jwks_new();
+	if (jwk_set == NULL)
