+ * @param item A JWK Item
+ * @param index The certificate index (0 is the leaf)
+ * @param len If not NULL, set to the length of the DER in bytes
+ * @return The DER bytes, or NULL if @p index is out of range
+ * @since 3.6.0
+ */
+JWT_EXPORT
