+		jwk_set = jwks_new();
+	if (jwk_set == NULL)
+		return NULL; // LCOV_EXCL_LINE
+
+	j_array = jwt_json_create_arr();
+	if (j_array == NULL)
+		return jwk_set; // LCOV_EXCL_LINE
