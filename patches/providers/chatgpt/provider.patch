+int mbedtls_jwk_to_psa(const mbedtls_jwk_t *key, int want_private,
+	psa_algorithm_t alg, psa_key_usage_t usage, mbedtls_svc_key_id_t *kid)
+{
+	psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
