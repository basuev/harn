diff --git a/providers/refuseless/provider.c b/providers/refuseless/provider.c
new file mode 100644
index 0000000..d1afa17
--- /dev/null
+++ b/providers/refuseless/provider.c
@@ -0,0 +1,23 @@
+#include "harn.h"
+#include "provider.h"
+
+static json_t *refuseless_catalog(json_t *catalog)
+{
+    json_t *models = catalog_data(catalog);
+    size_t i;
+    json_t *entry;
+    json_array_foreach(json_object_get(catalog, "data"), i, entry) {
+        json_t *levels = json_object_get(entry, "supported_reasoning_levels");
+        if (!json_is_array(levels))
+            json_object_set(json_array_get(models, i), "supported_reasoning_levels",
+                            json_object_get(entry, "reasoning_efforts"));
+    }
+    return models;
+}
+const Provider refuseless_provider = {
+    .id = "refuseless", .revision = "1", .auth_label = "API key",
+    .request_path = "/responses", .ready = api_key_ready, .logout = api_key_logout,
+    .models = responses_models, .catalog = refuseless_catalog, .headers = bearer_headers,
+    .encode = responses_encode, .event = responses_event,
+    .legacy = api_key_legacy,
+};
