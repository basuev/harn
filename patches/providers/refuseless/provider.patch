new file mode 100644
index 0000000..5437f2a
--- /dev/null
+++ b/providers/refuseless/check.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
+from provider_contract import Contract, run
+import unittest
+
+class RefuselessMetadata(unittest.TestCase):
+    setUp = Contract.setUp
+    tearDown = Contract.tearDown
+    run_batch = Contract.run_batch
+
+    def test_native_effort_metadata(self):
+        self.server.mode = "echo"
+        self.server.model_metadata = dict(supported_reasoning_levels=None,
+                                          reasoning_efforts=["off", "low", "high", "max"])
+        for level in ("off", "low", "high", "max"):
+            self.run_batch("EFFORT", "--effort", level)
+            self.assertEqual(self.server.requests[-1]["reasoning"], dict(effort=level))
+        count = len(self.server.requests)
+        self.run_batch("UNSUPPORTED", "--effort", "medium", expected=1)
+        self.assertEqual(len(self.server.requests), count)
+
+if __name__ == "__main__":
+    run("refuseless", key_env="REFUSELESS_API_KEY", extra=(RefuselessMetadata,))
